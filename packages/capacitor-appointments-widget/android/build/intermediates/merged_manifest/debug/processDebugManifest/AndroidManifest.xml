<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="at.alpiplan.plugins.widget" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <receiver
            android:name="at.alpiplan.plugins.widget.AppointmentsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_appointments_info" />
        </receiver>
        <receiver
            android:name="at.alpiplan.plugins.widget.WidgetActionReceiver"
            android:exported="false" />
    </application>

</manifest>